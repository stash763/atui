def add_common(p, defaults=True):
    """Connection options: the same ones for the relay and for every subcommand.

    `defaults` is False on a subcommand, and that is not tidiness.  argparse
    parses a subcommand into a namespace of its own and then copies all of it --
    defaults included -- over what the parent had already read, so a subcommand
    that repeats --host with a default quietly replaces the --host written before
    it.  Measured: `--host H --user U put f r` connected to the environment
    default instead, and the failure was a bare "connection refused".  SUPPRESS
    leaves the attribute untouched, which makes both positions work.
    """
    def default(value):
        return value if defaults else argparse.SUPPRESS

    p.add_argument("--host", default=default(DEFAULT_HOST))
    p.add_argument("--port", type=int, default=default(23))
    p.add_argument("--ftp-port", type=int, default=default(21))
    p.add_argument("--user", default=default(DEFAULT_USER))
    p.add_argument("--password", default=default(DEFAULT_PASSWORD))
    p.add_argument("--charset", default=default(DEFAULT_CHARSET),
                   help="target character set (default cp437; none for raw bytes)")
    p.add_argument("--ttype", default=default(DEFAULT_TTYPE),
                   help="terminal type to report (default %s)" % DEFAULT_TTYPE)
    p.add_argument("--no-naws", action="store_true", default=default(False),
                   help="do not report window size")
    p.add_argument("--timeout", type=float, default=default(15.0))
    p.add_argument("--prompt-re", default=default(""),
                   help="regex matching the target prompt (default: a shell prompt)")
    p.add_argument("--trace", action="store_true", default=default(False),
                   help="report negotiations")


def build_parser():
    p = argparse.ArgumentParser(
        prog="atui-remote", description="telnet bridge for driving a remote atui target",
        epilog="Run it under tui-test:\n"
               "  tui-test run --cols 80 --rows 25 -- tools/atui-remote --host HOST\n")
    add_common(p)
    p.add_argument("--cmd", default="", help="run this once logged in, then interact")
    p.add_argument("--exec", dest="exec_cmd", action="append", default=[],
                   help="non-interactive: run this, print output, exit.  Repeat "
                        "it to run several commands down one connection, which is "
                        "what this box's session slots prefer")
    p.add_argument("--no-login", action="store_true", help="do not answer login prompts")
    p.add_argument("--run-timeout", type=float, default=120.0)
    p.add_argument("--tries", type=int, default=3,
                   help="how often to make the whole telnet connection when the "
                        "box accepts it and says nothing.  It does that while "
                        "holding sessions that have not timed out yet -- and a "
                        "retry opens another one, so this is a small number on "
                        "purpose; when the box is deaf, waiting is what works")
    p.add_argument("--idle", type=float, default=1.2,
                   help="finish a command after this many quiet seconds")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--force-local-echo", action="store_true",
                   help="test hook: keep the local echo on, as cooked mode would")
    p.add_argument("--log-raw", default="",
                   help="write PREFIX.out / PREFIX.in byte-exact")

    sub = p.add_subparsers(dest="sub")

    s = sub.add_parser("serve", help="local fake target")
    add_common(s, defaults=False)
    s.add_argument("--mode", default="screen", choices=("screen", "frames"))
    s.add_argument("--frame-gap", type=float, default=2.0)
    s.add_argument("--idle-exit", type=float, default=0.0,
                   help="hang up after this long with no input (0: never)")
    s.add_argument("--once", action="store_true", help="serve one client and exit")

    sub.add_parser("bridge-test", help="local acceptance suite (needs tui-test)")

    q = sub.add_parser("probe", help="ask a real target the port's questions")
    add_common(q, defaults=False)
    q.add_argument("--probe-file", default="d:\\atui\\atui-esc.bin")

    u = sub.add_parser("put", help="FTP one file to the target")
    add_common(u, defaults=False)
    u.add_argument("file")
    u.add_argument("remote")

    g = sub.add_parser("get", help="FTP one file from the target")
    add_common(g, defaults=False)
    g.add_argument("remote")
    g.add_argument("file")

    y = sub.add_parser("sync", help="mirror the sources onto the target")
    add_common(y, defaults=False)
    add_sync_options(y)

    b = sub.add_parser("build", help="sync, run the makefile on the target, fetch the log")
    add_common(b, defaults=False)
    add_sync_options(b)
    b.add_argument("--batch", default="build.cmd",
                   help="batch file to run in the build root (default build.cmd)")
    b.add_argument("--batch-args", default="",
                   help="passed through to the batch file (build.cmd accepts "
                        "tvision or atui to build one half)")
    b.add_argument("--log", default="build.log", help="log name on the target")
    b.add_argument("--log-to", default=".atui-build.log",
                   help="where to keep the fetched log (default %s)")
    b.add_argument("--tail", type=int, default=0, help="show only the last N lines")
    b.add_argument("--no-sync", action="store_true", help="build what is already there")
    b.add_argument("--run-timeout", type=float, default=3600.0)
    b.add_argument("--log-poll", type=float, default=5.0,
                   help="seconds between looks for the target's log while it builds")
    b.add_argument("--idle", type=float, default=30.0,
                   help="a build is over after this many quiet seconds; must "
                        "exceed the time one source file takes")
    return p


def main(argv=None):
    args = build_parser().parse_args(sys.argv[1:] if argv is None else argv)
    if args.sub == "serve":
        return cmd_serve(args)
    if args.sub == "bridge-test":
        return cmd_bridge_test(args)
    if args.sub == "probe":
        return cmd_probe(args)
    if args.sub == "put":
        return cmd_put(args)
    if args.sub == "get":
        return cmd_get(args)
    if args.sub == "sync":
        return cmd_sync(args)
    if args.sub == "build":
        return cmd_build(args)
    return cmd_relay(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
