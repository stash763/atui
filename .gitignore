# build artifacts
build/
# the second configuration TESTING.md measures (-DATUI_HAVE_NETWORK=OFF)
build-off/
cmake/
*.o
*.a
*.obj
*.out
*.map
atui
atui.exe
.DS_Store

# local per-user atui config (not version controlled)
.atui/atui.json

# host-side tooling (tools/atui-remote is Python; nothing shipped depends on it)
__pycache__/
# what the target holds, and its last build log -- both machine-local caches
.atui-sync.json
.atui-build.log

# editors
*.swp
*.swo

# CI
.ci/

# logs fetched from the target (build evidence, not sources)
build-*.log
*.run.txt
build-asan/
build-nothreads/

# what the screenshot tool writes into the working directory, and the
# BMP the self-test round-trips through (transient by design)
atui_shot_*.bmp
atui_screen_test.bmp
